# ==========================================
# UPTIME KUMA ENVIRONMENT CONFIGURATION
# ==========================================

# Timezone
TZ=Asia/Jakarta

# Project Name
PROJECT_NAME=uptime-kuma-monitoring-vm

# Monitoring Information
MONITOR_NAME=Homelab Monitoring

# Telegram Notifications
TELEGRAM_ENABLED=true

# Example Variables
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# Server Information
SERVER_IP=192.168.1.10

# Docker
COMPOSE_PROJECT_NAME=uptime-kuma
